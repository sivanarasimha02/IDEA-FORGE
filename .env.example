# Environment Configuration Example
# Predictive Climate & Micro-Location Yield Engine

# Application
ENVIRONMENT=development
PORT=8000
SECRET_KEY=change_this_to_a_super_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL=sqlite:///./climate_engine.db
# For PostgreSQL/PostGIS (production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climate_yield_engine

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
COPERNICUS_API_KEY=optional_key_for_copernicus_dataspace

# Sensor IoT Gateway Security
SENSOR_GATEWAY_TOKEN=default_insecure_gateway_token_change_me

# Frontend
VITE_API_URL=http://localhost:8000
